# Copy to web/backend/.env and fill in.
#
# Three keys, one per debate agent. Each MUST come from a different Google Cloud
# project: the free-tier limit is 5 requests/minute per PROJECT, and one debate
# costs 4 calls, so keys issued from a single project share one bucket and buy
# nothing. Slot 1 falls back to the original single-key name.
#
# Translation works without these — the app falls back to showing and speaking
# the raw detected glosses, same as the Android build.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Comma-separated. Only needed when the frontend is not served through the Vite
# dev proxy (which forwards /api and /models, so no cross-origin request occurs).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
